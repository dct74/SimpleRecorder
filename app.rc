#include <windows.h>

// The manifest itself is embedded by the linker (/MANIFESTINPUT) through CMake;
// this file only exists so that the resource compiler runs for the project.
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "FileDescription", "SimpleRecorder - system/microphone audio recorder"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductName", "SimpleRecorder"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "OriginalFilename", "SimpleRecorder.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
